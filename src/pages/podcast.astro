---
import PageLayout from '@layouts/page.astro'
import IntroText from '@components/intro-text.astro'
import YouTubeVideo from '@components/youtube-video.astro'
import Courses from '@components/cta/courses.astro'
---

<PageLayout
  title="The NavBar Podcast — Web Dev & Content Creation"
  description="The NavBar is a web development podcast by Simon Vrachliotis and Jon Meyers from Supabase, covering modern web dev tools and content creation strategies."
  gradientStart="from-blue-400"
  gradientEnd="to-emerald-500"
>
  <div class="mx-auto max-w-3xl pt-10">
    <IntroText>
      The NavBar is a podcast by Jon Meyers and Simon Vrachliotis, covering all things web
      development and content creation.
    </IntroText>

    <YouTubeVideo id="pdFqdgYk8jA" />

    <div class="prose prose-purple max-w-none pb-8 pt-10 lg:prose-lg xl:prose-xl">
      <p>
        Watch our shows on <a href="https://www.youtube.com/@navbar8999">YouTube</a> and check out <a
          href="https://navbar.tech">The NavBar website</a
        >!
      </p>
    </div>
    <hr class="mb-4 ml-0 w-16 border-2 border-t border-gray-300" />
    <Courses />
  </div>
</PageLayout>
