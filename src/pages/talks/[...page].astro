---
import type { GetStaticPathsOptions } from 'astro'
import { getCollection } from 'astro:content'

import PageLayout from '@layouts/page.astro'
import List from '@components/list.astro'
import Pagination from '@components/pagination.astro'
import { PAGINATION_COUNT } from '@/config'
import Courses from '@components/cta/courses.astro'

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const talks = await getCollection('talks')
  const items = talks.sort(
    (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  )
  return paginate(items, { pageSize: PAGINATION_COUNT })
}
const { page } = Astro.props
---

<PageLayout
  title={page.currentPage > 1 ? `Talks — Page ${page.currentPage}` : 'Conference Talks & Speaking Appearances'}
  description="Watch recordings of Simon Vrachliotis's conference talks and presentations on Tailwind CSS, front-end development, and web design."
  gradientStart="from-rose-500"
  gradientEnd="to-fuchsia-500"
>
  <div class="mx-auto max-w-3xl">
    <List items={page.data} />
    <Pagination page={page} />
    <Courses />
  </div>
</PageLayout>
