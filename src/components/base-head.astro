---
import '../styles/global.css'
import { GoogleAnalytics } from 'astro-analytics'
import { SITE_TITLE } from '../config'

export interface Props {
  title: string
  description: string
  image: string
  type?: 'website' | 'article'
  publishedDate?: string
}

const { title, description, image, type = 'website', publishedDate } = Astro.props
const url = Astro.url
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const formattedTitle = url.pathname === '/' ? title : title + ' | simonswiss'
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<meta name="generator" content={Astro.generator} />

{/* Canonical URL */}
<link rel="canonical" href={canonicalURL} />

{/* RSS Autodiscovery */}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />

{/* Primary Meta Tags */}
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />

{/* Google Analytics */}
{url.hostname === 'simonswiss.com' && <GoogleAnalytics id="G-WV49SXX0P7" />}

{/* Open Graph / Facebook */}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content="simonswiss" />
{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate} />
)}
{type === 'article' && (
  <meta property="article:author" content="Simon Vrachliotis" />
)}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:site" content="@simonswiss" />
<meta name="twitter:creator" content="@simonswiss" />

{/* JSON-LD Structured Data */}
{url.pathname === '/' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "simonswiss",
    "url": Astro.site?.toString(),
    "description": description,
    "author": {
      "@type": "Person",
      "name": "Simon Vrachliotis",
      "url": Astro.site?.toString(),
      "jobTitle": "Web Designer, Developer & Video Producer",
      "sameAs": [
        "https://twitter.com/simonswiss",
        "https://youtube.com/@simonswiss",
        "https://github.com/simonswiss"
      ]
    }
  })} />
)}
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": new URL(image, Astro.url).toString(),
    "url": canonicalURL.toString(),
    ...(publishedDate && { "datePublished": publishedDate }),
    "author": {
      "@type": "Person",
      "name": "Simon Vrachliotis",
      "url": Astro.site?.toString()
    },
    "publisher": {
      "@type": "Person",
      "name": "Simon Vrachliotis",
      "url": Astro.site?.toString()
    }
  })} />
)}

{/* Fonts */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" cross-origin={true} />
<link
  href="https://fonts.googleapis.com/css2?family=Grandstander:wght@400;600&display=swap"
  rel="stylesheet"
/>
